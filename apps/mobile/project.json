{
  "name": "@bigmind/mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/mobile/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "^production"],
      "options": {
        "cwd": "apps/mobile",
        "command": "expo export --platform android --output-dir dist"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/mobile",
        "command": "expo start",
        "args": ["--clear"]
      },
      "configurations": {
        "go": {
          "command": "expo start --go",
          "args": ["--clear"]
        },
        "android": {
          "command": "expo start --android",
          "args": ["--clear"]
        },
        "dev-client": {
          "command": "expo start --dev-client",
          "args": ["--clear"]
        }
      }
    },
    "export": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  },
  "tags": ["type:app", "platform:mobile"]
}
