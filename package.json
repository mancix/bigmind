  "scripts": {
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose down",
    "db:migrate": "pnpm exec nx run @bigmind/api:migrate",
    "dev": "pnpm exec nx run-many -t serve -p @bigmind/web @bigmind/api --parallel=2",
    "test": "pnpm exec nx run-many -t test",
    "test:integration": "pnpm exec nx run @bigmind/api:test-integration",
    "lint": "pnpm exec nx run-many -t lint",
    "build:affected": "pnpm exec nx affected -t build"
  },
